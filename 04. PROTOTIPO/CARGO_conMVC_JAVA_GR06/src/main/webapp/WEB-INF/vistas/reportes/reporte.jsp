<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Reportes | Monster Salud · SIGH_GR06</title>
<link rel="stylesheet" href="${pageContext.request.contextPath}/css/site.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/departamentos.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/reportes.css"><script src="${pageContext.request.contextPath}/js/reportes.js" defer></script></head>
<body class="welcome-page dept-page report-page"><a class="skip-link no-print" href="#contenido">Ir al contenido principal</a><%@ include file="../fragmentos/cabecera.jspf" %><main id="contenido" class="dept-main">
<nav class="dept-breadcrumb no-print"><a href="${pageContext.request.contextPath}/inicio">Inicio</a> / <a href="${pageContext.request.contextPath}/reportes">Reportes</a> / <c:out value="${titulo}"/></nav>
<div class="dept-page-heading"><div><span class="eyebrow dept-eyebrow">HOSPITAL GENERAL MONSTER SALUD · REPORTE</span><h1><c:out value="${titulo}"/></h1></div><a class="button dept-button-secondary no-print" href="${pageContext.request.contextPath}/reportes">Volver a reportes</a></div>
<c:if test="${not empty campos}"><section class="dept-form-card no-print report-filter"><form method="get" action="${pageContext.request.contextPath}/reportes/${tipo}" class="report-grid">
<c:forEach var="campo" items="${campos}"><div class="dept-field"><label for="f-${campo.nombre}"><c:out value="${campo.etiqueta}"/></label><c:choose><c:when test="${campo.tipo eq 'select'}"><select id="f-${campo.nombre}" name="${campo.nombre}"><option value="">${campo.nombre eq 'perfil' or tipo eq 'persona' ? 'Seleccione' : 'Todos'}</option><c:forEach var="op" items="${campo.opciones}"><option value="<c:out value='${op[0]}'/>" ${campo.valor eq op[0] ? 'selected' : ''}><c:out value="${op[1]}"/></option></c:forEach></select></c:when><c:otherwise><input id="f-${campo.nombre}" name="${campo.nombre}" type="${campo.tipo}" value="<c:out value='${campo.valor}'/>" maxlength="${campo.max}"></c:otherwise></c:choose></div></c:forEach>
<div class="dept-form-actions report-actions"><button class="button button-primary" type="submit">Filtrar</button><a class="button dept-button-secondary" href="${pageContext.request.contextPath}/reportes/${tipo}">Limpiar</a><c:if test="${empty error and empty aviso and not empty columnas}"><button type="button" class="button button-primary" data-print>Imprimir o guardar PDF</button></c:if></div></form></section></c:if>
<c:if test="${not empty error}"><div role="alert" class="dept-alert dept-alert-error"><p><c:out value="${error}"/></p></div></c:if>
<c:if test="${not empty aviso}"><section class="dept-catalog report-filter"><p><c:out value="${aviso}"/></p></section></c:if>
<c:if test="${empty error and empty aviso and not empty columnas}"><section class="dept-catalog report-result"><div class="dept-catalog-heading"><div><h2>Resultado del reporte</h2><span class="dept-table-id">SIGH_GR06</span></div><c:if test="${tipo ne 'persona'}"><span class="dept-count">${total} registros</span></c:if></div>
<div class="report-summary"><c:forEach var="campo" items="${campos}"><span><strong><c:out value="${campo.etiqueta}"/>:</strong> <c:choose><c:when test="${empty campo.valor}">Todos</c:when><c:when test="${campo.tipo eq 'select'}"><c:forEach var="op" items="${campo.opciones}"><c:if test="${campo.valor eq op[0]}"><c:out value="${op[1]}"/></c:if></c:forEach></c:when><c:otherwise><c:out value="${campo.valor}"/></c:otherwise></c:choose></span></c:forEach></div>
<div class="dept-table-wrap"><table class="dept-table"><thead><tr><c:forEach var="col" items="${columnas}"><th scope="col"><c:out value="${col}"/></th></c:forEach></tr></thead><tbody><c:forEach var="fila" items="${filas}"><tr><c:forEach var="celda" items="${fila}" varStatus="i"><td data-label="<c:out value='${columnas[i.index]}'/>"><c:out value="${celda}"/></td></c:forEach></tr></c:forEach><c:if test="${empty filas}"><tr><td colspan="${columnas.size()}">No hay registros que coincidan con los filtros.</td></tr></c:if></tbody></table></div><c:if test="${tipo ne 'persona'}"><p class="report-total"><strong>Total de registros: ${total}</strong> <c:out value="${totales}"/></p></c:if></section></c:if></main><%@ include file="../fragmentos/pie.jspf" %></body></html>